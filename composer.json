{
    "name": "icetalker/filament-tab-repeater",
    "description": "Display Repeater as Tab",
    "keywords": [
        "icetalker",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "filament-tab-repeater"
    ],
    "homepage": "https://github.com/icetalker/filament-tab-repeater",
    "support": {
        "issues": "https://github.com/icetalker/filament-tab-repeater/issues",
        "source": "https://github.com/icetalker/filament-tab-repeater"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Martin H",
            "email": "termlong.com@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/forms": "^4.0||^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "filament/filament": "^5.8",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Icetalker\\FilamentTabRepeater\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Icetalker\\FilamentTabRepeater\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "lint": "pint",
        "test": "pest",
        "test:lint": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Icetalker\\FilamentTabRepeater\\FilamentTabRepeaterServiceProvider"
            ],
            "aliases": {
                "FilamentTabRepeater": "Icetalker\\FilamentTabRepeater\\Facades\\FilamentTabRepeater"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
